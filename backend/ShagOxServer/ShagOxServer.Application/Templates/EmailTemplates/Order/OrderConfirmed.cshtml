<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.OrderConfirmed</title>
</head>

<body style="margin:0; padding:0; background:#f4f4f4;
             font-family:Arial,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0"
       style="background:#f4f4f4; padding:30px 10px;">
    <tr>
        <td align="center">

            <table width="600" cellpadding="0" cellspacing="0"
                   style="max-width:600px; background:#ffffff;
                          border-radius:12px;">

                <tr>
                    <td align="center" style="padding:45px 30px;">

                        <div style="width:65px; height:65px;
                                    line-height:65px;
                                    background:#e8f5e9;
                                    color:#2e7d32;
                                    border-radius:50%;
                                    font-size:36px;
                                    font-weight:bold;">
                            ✓
                        </div>

                        <h1 style="color:#222; margin-top:25px;">
                            @Model.OrderConfirmed
                        </h1>

                        <p style="color:#777; line-height:1.6;">
                            @Model.ConfirmationMessage
                        </p>

                        <p style="color:#555; line-height:1.6;">
                            @Model.DeliveryMessage
                        </p>

                        <p style="color:#999; margin-top:25px;">
                            @Model.OrderTitle #@Model.OrderNumber
                        </p>

                        <p style="margin-top:30px;">
                            <a href="@Model.OrderUrl"
                               style="display:inline-block;
                                      background:#222;
                                      color:#fff;
                                      padding:15px 30px;
                                      text-decoration:none;
                                      border-radius:6px;">
                                @Model.ViewOrder
                            </a>
                        </p>

                    </td>
                </tr>

                <tr>
                    <td align="center"
                        style="padding:25px; color:#999;">
                        @Model.Footer
                    </td>
                </tr>

            </table>
        </td>
    </tr>
</table>

</body>
</html>
