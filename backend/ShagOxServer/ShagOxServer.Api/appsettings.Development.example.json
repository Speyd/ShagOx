{
  "ConnectionStrings": {
    // Database connection string.
    // Specify the database server, database name, and authentication credentials.
    // Example: Server=localhost;Database=ShagOxServer;Trusted_Connection=True;TrustServerCertificate=True;
    "DefaultConnection": ""
  },

  "Jwt": {
    // Name of the token issuer (your backend application).
    "Issuer": "ShagOxServer",

    // Intended recipient of the token (your client application).
    "Audience": "ShagOxClient",

    // JWT access token lifetime in minutes.
    "ExpireMinutes": 60,

    // Secret key used to protect cookies, if required by your authentication implementation.
    "CookieKey": "",

    // Prevents JavaScript from accessing the authentication cookie.
    "CookieHttpOnly": true,

    // Allows cookies to be sent only over HTTPS.
    "CookieSecure": true,

    // Cookie lifetime in days.
    "CookieExpireDays": 7

  },

  "Cloudinary": {
    // Cloudinary cloud name. Find it in your Cloudinary dashboard.
    "CloudName": "",

    // Cloudinary API key. Available in your Cloudinary dashboard.
    "ApiKey": "",

    // Cloudinary API secret. Keep this value private.
    "ApiSecret": ""

  },

  "Email": {
    // SMTP server hostname. Example: smtp.gmail.com.
    "SmtpHost": "",

    // SMTP server port. Commonly 587 for STARTTLS or 465 for implicit TLS.
    "SmtpPort": 587,

    // SMTP username, usually your email address.
    "Username": "",

    // SMTP password or app-specific password. Do not use your regular email password unless the provider explicitly requires it.
    "Password": "",

    // Sender email address displayed to recipients.
    "From": ""

  },

  "Google": {
    // OAuth 2.0 client ID from Google Cloud Console.
    "ClientId": "",

    // OAuth 2.0 client secret from Google Cloud Console. Keep it private.
    "ClientSecret": "",

    // Authorized redirect URI registered for your Google OAuth client.
    "RedirectUri": "",

    // OAuth grant type used by your authentication flow.
    "GrantType": "authorization_code",

    // Google OAuth token endpoint.
    "TokenLink": "https://oauth2.googleapis.com/token"

  },

  "Twilio": {
    // Product or application name used in your SMS integration.
    "ProductName": "",

    // Twilio Account SID from the Twilio Console.
    "AccountSID": "",

    // Twilio authentication token. Keep it private.
    "AuthToken": "",

    // Twilio phone number used to send messages, in E.164 format (e.g. +1234567890).
    "FromTwilio": ""

  },

  "RequestTracking": {
    // Number of tokens allowed before an IP address is banned.
    "MaxTokens": 5,

    // Number of HTTP requests required to generate one token.
    "RequestsPerToken": 200,

    // Maximum IP ban duration. TimeSpan format: hh:mm:ss.
    "BanDuration": "01:00:00",

    // How long request tracking data is stored in the cache.
    // TimeSpan format: d.hh:mm:ss.
    "CacheDuration": "1.00:00:00",

    // Number of progressive ban levels.
    "BanLevelCount": 3

  }
}
