# ============================================================
# JWT
# ============================================================

# Secret key used to sign JWT access tokens
# Replace with a strong, randomly generated secret.

JWT_SECRET=change_me


# ============================================================
# Redis
# ============================================================

# Redis data ACL credentials

REDIS_DATA_USER=shagox
REDIS_DATA_PASSWORD=change_me

# Redis application ACL credentials

REDIS_USER=shagox_user
REDIS_USER_PASSWORD=change_me

# Redis ports

REDIS_DATA_PORT=6379
REDIS_USER_PORT=6380


# ============================================================
# PostgreSQL
# ============================================================

# PostgreSQL application credentials

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Default PostgreSQL database

POSTGRES_DB=shagox

# PostgreSQL Docker internal port

POSTGRES_DOCKER_PORT=5432


# ============================================================
# PostgreSQL Replication
# ============================================================

# Dedicated PostgreSQL replication user

REPLICATOR_USER=replicator
REPLICATOR_PASSWORD=change_me


# ============================================================
# PostgreSQL Hosts
# ============================================================

# Hostname of the PostgreSQL primary instance

POSTGRES_PRIMARY_HOST=localhost

# Hostname of the PostgreSQL replicas

POSTGRES_REPLICA_HOST=localhost


# ============================================================
# PostgreSQL Ports
# ============================================================

# Host port mapped to the PostgreSQL primary instance

POSTGRES_PRIMARY_PORT=5433

# Host ports mapped to the PostgreSQL replica instances

POSTGRES_REPLICA_1_PORT=5434
POSTGRES_REPLICA_2_PORT=5435
POSTGRES_REPLICA_3_PORT=5436


# ============================================================
# PostgreSQL Replica Containers
# ============================================================

# Docker container names

POSTGRES_PRIMARY_CONTAINER=postgres-primary

POSTGRES_REPLICA_1_CONTAINER=postgres-replica-1
POSTGRES_REPLICA_2_CONTAINER=postgres-replica-2
POSTGRES_REPLICA_3_CONTAINER=postgres-replica-3

# Comma-separated replica container names

POSTGRES_REPLICA_CONTAINER_NAMES=postgres-replica-1,postgres-replica-2,postgres-replica-3


# ============================================================
# PgBouncer
# ============================================================

# PgBouncer authentication credentials

PGBOUNCER_USER=pgBouncer
PGBOUNCER_PASSWORD=change_me

# PgBouncer host and port

PGBOUNCER_PORT_HOST=localhost
PGBOUNCER_PORT=6432

# PgBouncer primary database (write)

PGBOUNCER_PRIMARY_DATABASE=mydb_write

# PgBouncer replica databases (read)

PGBOUNCER_REPLICA_DATABASES=mydb_read_1,mydb_read_2,mydb_read_3

# PgBouncer Docker container

PGBOUNCER_CONTAINER=pgbouncer