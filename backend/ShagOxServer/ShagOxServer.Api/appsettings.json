{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "VerificationCode": {
    "MinValue": 100000,
    "MaxValue": 1000000,
    "MaxAttempts": 3,
    "ExpirationMinutes": 10
  },
  "UserCleanup": {
    "CleanupInterval": "01:00:00",
    "UserLifetime": "24:00:00"
  },
  "VerificationCodeCleanup": {
    "CleanupInterval": "01:00:00"
  },
  "DatabaseHealthCheck": {
    "CheckInterval": "00:01:00",
    "CommandTimeoutSeconds": 3,
    "CheckTimeout": "00:00:03"
  },
  "LoadBalancer": {
    "MaxHealthAge": "00:01:30"
  },
  "UserNameGenerate": {
    "MaxAttempts": 100
  },
  "Cache": {
    "KeyExpiration": "01:00:00"
  },
  "RequestTracking": {
    "MaxTokens": 5,
    "RequestsPerToken": 200,
    "BanDuration": "01:00:00",
    "CacheDuration": "24:00:00",
    "BanLevelCount": 3
  },
  "UpdateLastSeen": {
    "UpdateInterval": "00:10:00"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Expressions"
    ],

    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },

    "Enrich": [
      "FromLogContext"
    ],

    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": { "expression": "StartsWith(SourceContext, 'ShagOxServer')" }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "logs/application-.log",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 30,
                  "fileSizeLimitBytes": 10485760,
                  "rollOnFileSizeLimit": true,
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} | {Message:lj}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByExcluding",
                "Args": { "expression": "StartsWith(SourceContext, 'ShagOxServer')" }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "logs/server-.log",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 30,
                  "fileSizeLimitBytes": 10485760,
                  "rollOnFileSizeLimit": true,
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      }
    ]
  },
  "Redis": {
    "Ssl": true,
    "CaPath": "infrastructure/my_redis/certs/ca",
    "CaKeyPath": "infrastructure/my_redis/certs/ca",
    "CaFileName": "ca.crt",
    "ClientPath": "infrastructure/my_redis/certs/client",
    "ClientCrtFileName": "client.crt",
    "ClientKeyFileName": "client.key"
  },
  "UserRedis": {
    "Ssl": true,
    "CaPath": "infrastructure/my_redis/certs/ca",
    "CaKeyPath": "infrastructure/my_redis/certs/ca",
    "CaFileName": "ca.crt",
    "ClientPath": "infrastructure/my_redis/certs/client",
    "ClientCrtFileName": "client.crt",
    "ClientKeyFileName": "client.key"
  },
  "AllowedHosts": "*"
}
