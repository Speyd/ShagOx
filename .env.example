# ============================================================
# JWT
# ============================================================

# Secret key used to sign JWT access tokens
# Change this value in your local .env file.
JWT_SECRET=change_me

# ============================================================
# Redis
# ============================================================

# Redis ACL username
REDIS_USER=shagox

# Redis ACL password
# Change this value in your local .env file.
REDIS_PASSWORD=change_me


# ============================================================
# PostgreSQL
# ============================================================

# PostgreSQL application username
POSTGRES_USER=postgres

# PostgreSQL application password
# Change this value in your local .env file.
POSTGRES_PASSWORD=change_me

# Default PostgreSQL database
POSTGRES_DB=shagox


# ============================================================
# PostgreSQL Replication
# ============================================================

# Dedicated PostgreSQL replication user
REPLICATOR_USER=replicator

# Password for the replication user
# Change this value in your local .env file.
REPLICATOR_PASSWORD=change_me


# ============================================================
# PostgreSQL Ports
# ============================================================

# Host port mapped to the PostgreSQL primary instance
POSTGRES_PRIMARY_PORT=5433

# Host port mapped to the PostgreSQL replica instance
POSTGRES_REPLICA_PORT=5434